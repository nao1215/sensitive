# Golden offsets refer to LF fixture bytes on every platform.
testdata/mixed.log text eol=lf
testdata/mixed.golden text eol=lf

# go mod tidy emits LF on every platform.
*.mod text eol=lf
*.sum text eol=lf

# API snapshots and executable documentation compare exact bytes.
*.golden text eol=lf
*.md text eol=lf
*.go text eol=lf

# Measured JSON snapshots and fingerprints use identical bytes on every platform.
doc/*.json text eol=lf

# Preserve Go benchmark CPU headers exactly, including padded processor names.
doc/performance/*-bench*.txt whitespace=-blank-at-eol
